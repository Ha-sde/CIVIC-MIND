# Copy to .env and edit. Every variable is optional - sensible defaults exist.
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars
DATABASE_URL=sqlite:///./data/civicmind.db     # or postgresql://user:pass@host:5432/dbname

# OTP login. "demo" = fixed code shown on screen. "log" = random code printed to the server log.
OTP_MODE=demo
DEMO_OTP=123456
OFFICIAL_INVITE_CODE=                          # set to require a code when officials register

# AI engine. Leave the key empty to run fully offline on the built-in engine.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Behaviour
CLUSTER_RADIUS_M=150
ACK_SLA_HOURS=48
REOPEN_WINDOW_DAYS=7
MAX_UPLOAD_MB=15
SEED_DEMO=true                                 # set false in production
MAP_DEFAULT=16.7050,74.2433                    # lat,lon the map opens on
# PRIORITY_WEIGHTS={"reports":0.3,"severity":0.3,"category":0.15,"age":0.15,"vulnerability":0.1}
